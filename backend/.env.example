# The backend loads the SAME .env as the Phase 3/4 RAG layer, from the
# project root (see app/config.py) — GROQ_API_KEY does not need to be
# duplicated here. This file documents the backend-specific additions.
#
# Your real project-root .env already has:
#   GROQ_API_KEY=your_groq_api_key_here
#
# Backend-specific (optional — config.py provides a sensible default if unset):
DATABASE_URL=sqlite:///./legal_ai.db
