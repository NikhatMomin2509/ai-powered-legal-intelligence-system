# The backend loads the SAME .env as the Phase 3/4 RAG layer, from the
# project root (see app/config.py) — GROQ_API_KEY does not need to be
# duplicated here. This file documents the backend-specific additions.
#
# Your real project-root .env already has:
#   GROQ_API_KEY=your_groq_api_key_here
#
# Backend-specific (optional — config.py provides a sensible default if unset):
DATABASE_URL=sqlite:///./legal_ai.db

# Authentication (privacy/auth feature). REQUIRED for stable sessions:
# generate once with:  python -c "import secrets; print(secrets.token_hex(32))"
# and put the result in your PROJECT-ROOT .env (never commit it, never put it in
# frontend code). If unset, a random per-process secret is generated and a warning
# is logged — safe, but every login is invalidated on each server restart.
JWT_SECRET_KEY=generate_a_long_random_value_and_paste_it_here
JWT_EXPIRY_HOURS=24
